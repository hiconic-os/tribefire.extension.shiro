<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>Login</title>
<meta name="viewport" content="initial-scale=1, width=device-width, maximum-scale=1, minimum-scale=1, user-scalable=no">
<link href='${publicServicesUrl}/webpages/fonts/fonts.css' rel='stylesheet' type='text/css'>
<link rel="shortcut icon" href="${publicServicesUrl}/webpages/favicon.ico" type="image/x-icon"/>

<style>
html, body {
	min-height: 100%;
	margin: 0;
}
body {
	background: #f5f7fa;
}
div.loginContent {
	min-height: 100vh;
	display: flex;
	align-items: center;
	justify-content: center;
	box-sizing: border-box;
	padding: 32px 16px;
	font-family: 'Open Sans', sans-serif;
	font-weight: 400;
	font-size: 16px;
	color: #283341;
	-webkit-font-smoothing: antialiased;
}
.loginPanel {
	width: min(100%, 420px);
}
*.loginContent input, *.loginContent button {
	font-family: 'Open Sans', sans-serif;
	font-size: 15px;
	box-sizing: border-box;
}
*.loginContent h2 {
	margin: 0 0 8px;
	font-size: 28px;
	font-weight: 600;
	letter-spacing: -0.02em;
	color: #1f2937;
	text-align: center;
}
.loginSubtitle {
	margin: 0 0 24px;
	color: #6b7280;
	font-size: 14px;
	line-height: 1.5;
	text-align: center;
}
form.loginForm {
	position: relative;
	box-sizing: border-box;
	width: 100%;
	margin: 0;
	padding: 32px;
	background: #fff;
	border: 1px solid #e2e8f0;
	border-radius: 14px;
	box-shadow: 0 16px 40px rgba(15, 23, 42, 0.10);
	overflow: hidden;
	animation: loginAppear 180ms ease-out;
}
.loginField {
	margin-bottom: 14px;
}
*.loginContent input[type="text"], *.loginContent input[type="password"] {
	width: 100%;
	height: 44px;
	padding: 0 13px;
	border: 1px solid #cbd5e1;
	border-radius: 8px;
	background: #fff;
	color: #1f2937;
	transition: border-color 120ms ease, box-shadow 120ms ease;
}
*.loginContent input[type="text"]:focus, *.loginContent input[type="password"]:focus {
	border-color: #f59e0b;
	box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.16);
	outline: none;
}
*.loginContent input[type="checkbox"] {
	height: 15px;
	width: 15px;
	accent-color: #f59e0b;
}
*.loginContent button {
	width: 100%;
	min-height: 44px;
	padding: 9px 16px;
	border: 1px solid #e69000;
	border-radius: 8px;
	background: #f59e0b;
	font-weight: 600;
	color: white;
	cursor: pointer;
	transition: background-color 120ms ease, box-shadow 120ms ease, transform 80ms ease;
}
*.loginContent button:hover:not(:disabled) { background: #e69000; }
*.loginContent button:focus-visible, *.loginContent a.loginOption:focus-visible {
	outline: 3px solid rgba(245, 158, 11, 0.28);
	outline-offset: 2px;
}
*.loginContent button:active:not(:disabled) { transform: translateY(1px); }
*.loginContent button:disabled { opacity: 0.58; cursor: not-allowed; }
.loginStaySigned {
	display: flex;
	align-items: center;
	justify-content: center;
	gap: 7px;
	margin: 2px 0 18px;
	font-size: 13px;
	color: #64748b;
}
.loginMessage {
	box-sizing: border-box;
	margin: 18px 0;
	padding: 12px 14px;
	border: 1px solid #fecaca;
	border-radius: 8px;
	background: #fff7f7;
	color: #9f1239;
	font-size: 14px;
	line-height: 1.45;
	text-align: left;
	overflow-wrap: anywhere;
}
.loginMessageOk {
	border-color: #bbf7d0;
	background: #f0fdf4;
	color: #166534;
}
.loginMessage strong, .loginMessage span {
	display: block;
}
.loginMessage strong {
	margin-bottom: 3px;
	font-weight: 700;
}
.loginMessage span {
	white-space: pre-line;
}
.loginMessageAction, *.loginContent a.loginRetryOption {
	margin-top: 14px;
}
*.loginContent a.loginRetryOption {
	background: transparent;
}
.loginOptionRow { margin-top: 12px; }
*.loginContent a.loginOption {
	display: flex;
	align-items: center;
	justify-content: center;
	gap: 10px;
	box-sizing: border-box;
	width: 100%;
	min-height: 48px;
	padding: 8px 12px;
	border: 1px solid #cbd5e1;
	border-radius: 8px;
	background: #fff;
	color: #334155;
	font-weight: 600;
	text-decoration: none;
	transition: border-color 120ms ease, background-color 120ms ease;
}
*.loginContent a.loginOption:hover {
	border-color: #f59e0b;
	background: #fffbeb;
}
*.loginContent a.loginOption img {
	width: 28px;
	height: 28px;
	margin: 0;
	object-fit: contain;
}
.loginBusyMask {
	position: absolute;
	inset: 0;
	z-index: 10;
	display: flex;
	align-items: center;
	justify-content: center;
	background: rgba(255,255,255,0.90);
	backdrop-filter: blur(2px);
	opacity: 0;
	visibility: hidden;
	pointer-events: none;
	transition: opacity 180ms ease, visibility 0s linear 180ms;
}
.loginBusyMaskVisible {
	opacity: 1;
	visibility: visible;
	pointer-events: auto;
	transition: opacity 180ms ease;
}
.loginBusyIndicator {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 12px;
	color: #475569;
	font-size: 14px;
	font-weight: 500;
}
.loginBusySpinner {
	width: 28px;
	height: 28px;
	border: 3px solid rgba(245,158,11,0.25);
	border-top-color: #f59e0b;
	border-radius: 50%;
	animation: loginBusySpin 700ms linear infinite;
}
.loginDivider {
	display: flex;
	align-items: center;
	gap: 12px;
	margin: 20px 0 8px;
	color: #94a3b8;
	font-size: 12px;
	text-transform: uppercase;
	letter-spacing: 0.08em;
}
.loginDivider::before, .loginDivider::after {
	content: "";
	flex: 1;
	height: 1px;
	background: #e2e8f0;
}
@keyframes loginAppear {
	from { opacity: 0; transform: translateY(4px); }
	to { opacity: 1; transform: translateY(0); }
}
@keyframes loginBusySpin { to { transform: rotate(360deg); } }
@media (prefers-reduced-motion: reduce) {
	form.loginForm, .loginBusyMask, .loginBusySpinner { animation: none; transition: none; }
}
@media (max-width: 480px) {
	div.loginContent { align-items: flex-start; padding: 20px 12px; }
	form.loginForm { padding: 24px 20px; }
}
</style>

<script>

var busyRevealTimer;

function bindForm() {
	var form = document.getElementById("signinForm");
	#if(${showStandardLoginForm})
	form.addEventListener("submit", function (event) {
		event.preventDefault();
		login();
	});
	#end
	document.querySelectorAll("a.loginOption").forEach(function (option) {
		option.addEventListener("click", function () { setBusy(true, "Continuing to sign in…"); });
	});
	var action = document.getElementById("loginAction");
	if (action) {
		action.addEventListener("click", function () {
			setBusy(true, "Requesting approval…");
		});
	}
}

function login() {
	var loginData = new Object();
	loginData.user = document.getElementById("input_user").value;
	loginData.password = document.getElementById("input_password").value;
	#if($offerStaySigned)
	loginData.staySignedIn = document.getElementById("staySigned").checked;
	#end

    var loginDataJson= JSON.stringify(loginData);
	
	var request = new XMLHttpRequest();
	
 	// Set up our request
 	request.open('POST', '${publicServicesUrl}/login/auth');
	request.setRequestHeader("Content-Type","application/json");
	request.setRequestHeader("Accept","application/json");
	setBusy(true, "Signing in…");
	
	// Define repsonse handling
	request.onreadystatechange = function () {
		
		if(request.readyState == 4) {
			
			if (request.status == 200) {
				var sessionId = request.responseText;
				
				var redirectLocation = "${publicServicesUrl}"; // default redirect to current page
				
				
				
				window.location = redirectLocation; // redirect to landing page
			} else {
				setBusy(false);
				var failureMessage = "Could not sign in";
				try {
					var failure = JSON.parse(request.responseText);
					if (failure.message && failure.message.length > 0) {
						failureMessage = failure.message;
					} else if (failure.text && failure.text.length > 0) {
						failureMessage = failure.text;
					}
				
				} catch (err) {
					console.log("Could not parse response text");
				}	
				renderMessage("Sign in failed", failureMessage, false);
			}
		}
	}
	
 	// Send login request
 	request.send(loginDataJson);
}

function renderMessage(title, message, ok) {
	var box = document.getElementById("loginMessage");
	box.hidden = false;
	box.classList.toggle("loginMessageOk", !!ok);
	document.getElementById("loginMessageTitle").textContent = title || "";
	document.getElementById("loginMessageText").textContent = message || "";
}

function setBusy(busy, label) {
	var form = document.getElementById("signinForm");
	var mask = document.getElementById("loginBusyMask");
	clearTimeout(busyRevealTimer);
	form.setAttribute("aria-busy", busy ? "true" : "false");
	document.getElementById("loginBusyLabel").textContent = label || "Signing in…";
	document.querySelectorAll("button, input, a.loginOption").forEach(function (control) {
		if (control.tagName === "A") {
			control.setAttribute("aria-disabled", busy ? "true" : "false");
		} else {
			control.disabled = busy;
		}
	});
	if (busy) {
		busyRevealTimer = setTimeout(function () {
			mask.classList.add("loginBusyMaskVisible");
			mask.setAttribute("aria-hidden", "false");
		}, 150);
	} else {
		mask.classList.remove("loginBusyMaskVisible");
		mask.setAttribute("aria-hidden", "true");
	}
}

</script>

</head>
<body onLoad="bindForm()">

  <div class="loginContent">
	<div class="loginPanel">
		<h2>#if($externalIntervention)Device/browser approval#else Sign in to ${applicationName}#end</h2>
		<p class="loginSubtitle">#if($externalIntervention)Complete this step before signing in.#else Choose a sign-in method to continue.#end</p>
		<form id="signinForm" action="${publicServicesUrl}/login/auth" class="loginForm" accept-charset="UTF-8">
			<div id="loginBusyMask" class="loginBusyMask" aria-hidden="true">
				<div class="loginBusyIndicator" role="status" aria-live="polite">
					<span class="loginBusySpinner" aria-hidden="true"></span>
					<span id="loginBusyLabel">Signing in&hellip;</span>
				</div>
			</div>
	#if($externalIntervention)
			<div id="loginMessage" role="status" aria-live="polite"
				class="loginMessage#if($messageStatus == 'OK' || $interventionState == 'PENDING') loginMessageOk#end">
				<strong id="loginMessageTitle">#if($interventionTitle)$tools.escape($interventionTitle)#elseif($message)Sign in failed#else Approval status#end</strong>
				<span id="loginMessageText">#if($interventionMessage)$tools.escape($interventionMessage)#elseif($message)$tools.escape($message)#end</span>
				#if($interventionActionUrl && $interventionActionLabel)
					<a id="loginAction" class="loginOption loginMessageAction"
						href="$tools.escape($interventionActionUrl)">$tools.escape($interventionActionLabel)</a>
				#elseif($externalRetryUrl)
					<a class="loginOption loginRetryOption" href="$tools.escape($externalRetryUrl)">$tools.escape($externalRetryLabel)</a>
				#end
			</div>
	#elseif(${showStandardLoginForm})
			<div class="loginField">
				<input id="input_user" type="text" name="user" placeholder="Username" autofocus>
			</div>
			<div class="loginField">
				<input id="input_password" type="password" name="password" placeholder="Password">
			</div>
			<div class="loginField">
				<button type="submit">Sign in</button>
			</div>
			#if($offerStaySigned)
			<div class="loginStaySigned">
				<input id="staySigned" type="checkbox" name="staySigned" checked="checked" value="true" />
				<label for="staySigned">Stay signed in</label>
			</div>
			#end
			#if ($continue)
				<input type="hidden" name="continue" value="$tools.escape($continue)" />
			#end
	#end

			<div id="loginMessage" role="alert" aria-live="polite"
				class="loginMessage#if($messageStatus == 'OK') loginMessageOk#end" #if(!$message)hidden#end>
				<strong id="loginMessageTitle">#if($messageStatus == "OK")Information#else
					Sign in failed#end</strong>
				<span id="loginMessageText">#if($message)$tools.escape($message)#end</span>
			</div>
	
	#if(!$externalIntervention && ${showTextLinks})
		#if(${showStandardLoginForm})<div class="loginDivider"><span>or</span></div>#end
		#foreach($authUrlEntry in $authUrls.entrySet())<div class="loginOptionRow"><a class="loginOption" href="${authUrlEntry.value}">Sign in with ${authUrlEntry.key}</a></div>#end
	#elseif(!$externalIntervention)
		#if(${showStandardLoginForm})<div class="loginDivider"><span>or</span></div>#end
		#foreach($authUrlEntry in $authUrls.entrySet())
			<div class="loginOptionRow"><a class="loginOption" href="${authUrlEntry.value}">
		
			#set( $imageUrl = ${authImageUrls.get(${authUrlEntry.key})} )
			#set( $imageContent = ${authEmbeddedImages.get(${authUrlEntry.key})} )
		
			#if(${imageContent})
			
					<img src="${imageContent}" alt="">
					<span>Sign in with ${authUrlEntry.key}</span>
			
			#else
					<img src="${imageUrl}" alt="">
					<span>Sign in with ${authUrlEntry.key}</span>
				
			#end
		
			</a></div>
		#end
	#end

		</form>
	</div>
  </div>
</body>
</html>
